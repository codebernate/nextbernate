{
  "name": "nextbernate",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --max-warnings=0 .",
    "lint:eslint": "eslint --max-warnings=0 .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "knip": "knip",
    "check": "pnpm format:check && pnpm lint && pnpm lint:eslint && pnpm test && pnpm typecheck && pnpm knip && pnpm build",
    "prepare": "node scripts/install-hooks.mjs",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "commit": "cz",
    "ui:add": "shadcn add"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.2",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "commitizen": "4.3.2",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-oxlint": "1.87.0",
    "knip": "6.39.0",
    "lefthook": "2.1.17",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "semantic-release": "25.0.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "10.33.2"
  },
  "packageManager": "pnpm@10.33.2"
}
