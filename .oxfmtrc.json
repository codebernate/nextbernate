{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "sortImports": false,
  "sortTailwindcss": {
    "stylesheet": "./src/app/globals.css",
    "functions": ["cn", "cva"]
  },
  "ignorePatterns": [
    "node_modules/**",
    ".next/**",
    "out/**",
    "build/**",
    "coverage/**",
    "pnpm-lock.yaml",
    "next-env.d.ts",
    ".agents/skills/**",
    "knowledge/.obsidian/**",
    "docs/superpowers/**"
  ]
}
